        #network_name="5910044_0"
    output:
        coil_unet_prediction = "{datasets}raw_stack_background_subtracted_mask_coilnet.btf"
    run:
        from imutils.src import imutils_parser_main

        imutils_parser_main.main([
            params.function,
            '-bi', str(input.binary_input_img),
            '-ri', str(input.raw_input_img),
            '-o', str(output.coil_unet_prediction),
            '-w', str(params.weights_path),
        ])
        #"python {input.script} {params.function} -bi {input.binary_input_img} -ri {input.raw_input_img} -o {output.coil_unet_prediction} -w {params.weights_path}"

