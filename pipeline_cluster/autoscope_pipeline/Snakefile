rule reformat_skeleton_files:
    input:
        script = "/scratch/neurobiology/zimmer/ulises/code/centerline/centerline/dev/reformat_skeleton_files.py",
        spline_K= "{datasets}skeleton_spline_K.csv",
        spline_X= "{datasets}skeleton_spline_X_coords.csv",
        spline_Y= "{datasets}skeleton_spline_Y_coords.csv",
        #spline_list = datasetssample}_spline_K.csv", "{sample}_spline_X_coords.csv", "{sample}_spline_Y_coords.csv",]

    output:
        merged_spline_file = "{datasets}skeleton_merged_spline_data.csv",

    shell:
        "python {input.script} -i_K {input.spline_K} -i_X {input.spline_X} -i_Y {input.spline_Y} -o {output.merged_spline_file}"


rule annotate_behaviour:
    input:
        script = "/scratch/neurobiology/zimmer/ulises/code/curvature/curvature/src/annotate_behaviour_snakemake.py",
        curvature_file = "{datasets}skeleton_spline_K.csv" #Might or might not need to be the signed version

    params:
        #pca_model_path = "/scratch/neurobiology/zimmer/ulises/code/curvature/curvature/models/1651_20220810_eigenworm_PCA_bodypart_30_to_80.pkl"
        pca_model_path = config["pca_model_path"],
        #features should be added here, and maybe rolling mean (or use averaged splineK instead)
        initial_segment = config["initial_segment"],
        final_segment = config["final_segment"],
        window = config["window"]
    output:
        principal_components = "{datasets}principal_components.csv",
        behaviour_annotation = "{datasets}beh_annotation.csv"

    shell :
        "python {input.script} -i {input.curvature_file} -pca {params.pca_model_path} -i_s {params.initial_segment} -f_s {params.final_segment} -win {params.window} -o_pc {output.principal_components} -o_bh {output.behaviour_annotation}"

