# This rule erodes the binary mask from the background-subtracted image for a specified number of iterations and saves the eroded image.

rule erode_binary_mask:
    input:
        binary_img = "{datasets}raw_stack_background_subtracted_mask_coilnet_binarized.btf"
    params:
        iter =  config['iterations']
    output:
        erode_img = "{datasets}raw_stack_background_subtracted_mask_eroded.btf"
    run:
        import pandas as pd
        import numpy as np
        import tifffile as tiff
        from scipy import ndimage

        with tiff.TiffFile(input.binary_img, multifile=False) as tif, tiff.TiffWriter(output.erode_img, bigtiff=True) as output_tif:
             for i, page in enumerate(tif.pages):
                 img = page.asarray()
                 eroded_img = ndimage.binary_erosion(img,iterations=params.iter)
                 eroded_img = eroded_img * 255
                 eroded_img = eroded_img.astype(np.uint8)
                 #eroded_img = np.array(eroded_img, dtype=np.uint8)
                 # save as a btf
                 output_tif.write(eroded_img,photometric='minisblack',contiguous=True)

rule create_centerline:
    input:
        #TODO: Try ancient() to see if I can avoid re-running when the script is modified
        input_binary_img = "{datasets}raw_stack_background_subtracted_mask_eroded.btf",
        hdf5_file = "{datasets}raw_stack_downsampled"+config["network_string"]+".h5" if (config["downsample_for_DLC"] == 1) else "{datasets}raw_stack"+config["network_string"]+".h5"
        #hdf5_file = "{datasets}raw_stack"+config["network_string"]+".h5" #"AVG_background_subtracted_normalisedDLC_resnet50_wbfm_nose_tailJan4shuffle1_1030000.h5"

    params:
        csv_output_path = "{datasets}",  # This cant go into inputs because it is not a file
        number_of_neighbours = "1",
        nose = config['nose'],
        tail = config['tail'],
        num_splines = config['num_splines'],
        downsample_for_DLC= config["downsample_for_DLC"],
        fill_with_DLC = "1" # TODO: Improve so argparse takes boolean

    output :
        output_skel_X = "{datasets}skeleton_skeleton_X_coords.csv",
        output_skel_Y = "{datasets}skeleton_skeleton_Y_coords.csv",
        output_spline_K = "{datasets}skeleton_spline_K.csv",
        output_spline_X = "{datasets}skeleton_spline_X_coords.csv",
        output_spline_Y = "{datasets}skeleton_spline_Y_coords.csv",
        corrected_head = "{datasets}skeleton_corrected_head_coords.csv",
        corrected_tail = "{datasets}skeleton_corrected_tail_coords.csv"
    run:
        from centerline.dev import head_and_tail

        head_and_tail.main([
            '-i', str(input.input_binary_img),
            '-h5', str(input.hdf5_file),
            '-o', str(params.csv_output_path),
            '-nose', str(params.nose),
            '-tail', str(params.tail),
            '-num_splines', str(params.num_splines),
            '-n', str(params.number_of_neighbours),
            '-dlc', str(params.fill_with_DLC),
            '-ds', str(params.downsample_for_DLC),
        ])

        #"python {input.script} -i {input.input_binary_img} -h5 {input.hdf5_file} -o {params.csv_output_path} -nose {params.nose} -tail {params.tail} -num_splines {params.num_splines} -n {params.number_of_neighbours} -dlc {params.fill_with_DLC} -ds {params.downsample_for_DLC}"

