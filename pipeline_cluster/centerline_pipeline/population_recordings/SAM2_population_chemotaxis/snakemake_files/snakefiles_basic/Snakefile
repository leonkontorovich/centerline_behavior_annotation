rule create_centerline:
    input:
        input_binary_img = "{datasets_output}track_mask_corrected.btf",
        hdf5_file = "{datasets_output}track"+config["network_string"]+"_filtered.h5"
    
    params:
        head_annotation = config['nose'],
        tail_annotation = config['tail'],
        number_of_spline = config['num_splines'],
        min_worm_length = config['min_worm_lenght']
        
    output:
        output_spline_K = "{datasets_output}skeleton_spline_K.csv",
        output_spline_X = "{datasets_output}skeleton_spline_X_coords.csv",
        output_spline_Y = "{datasets_output}skeleton_spline_Y_coords.csv",
    run:
        from centerline_behavior_annotation.centerline.dev import head_and_tail_low_res
        
        head_and_tail_low_res.main([
            '--input_binary_mask', str(input.input_binary_img),
            '--input_dlc_h5', str(input.hdf5_file),
            '--head_annotation', str(params.head_annotation),
            '--tail_annotation', str(params.tail_annotation),
            '--number_of_spline', str(params.number_of_spline),
            '--min_worm_length', str(params.min_worm_length)
        ])


rule delete_temp_data:
    input:
        avi = "{datasets_output}track.avi",
        processed_stack = "{datasets_output}track_mask_corrected.btf",
        output_file = "{datasets_output}track_mask.btf",
        output_spline_K = "{datasets_output}skeleton_spline_K.csv",
        output_spline_X = "{datasets_output}skeleton_spline_X_coords.csv",
        output_spline_Y = "{datasets_output}skeleton_spline_Y_coords.csv",
    output:
        # This is a dummy output to ensure the rule is executed
        temp_cleanup = temp("{datasets_output}temp_cleanup.done")
    run:
        import os

        # List of files to delete
        files_to_delete = [input.avi, input.processed_stack, input.output_file]

        for file in files_to_delete:
            if os.path.exists(file):
                os.remove(file)
                print(f"Deleted: {file}")
            else:
                print(f"File not found: {file}")

        # Create a dummy file to mark completion
        with open(output.temp_cleanup, 'w') as f:
            f.write("Temporary files cleaned up")


rule annotate_reversals:
    input:
        curvature_file = "{datasets_output}skeleton_spline_K.csv"
    params:
        pca_model_path = config["pca_model_path"],
        initial_segment = config["initial_segment"],
        final_segment = config["final_segment"],
        window = config["window"],
        upper_threshold = config["upper_threshold"],
        lower_threshold = config["lower_threshold"]
    output:
        principal_components = "{datasets_output}principal_components.csv",
        behaviour_annotation = "{datasets_output}reversal_annotation.csv"

    run:
        from centerline_behavior_annotation.curvature.src import annotate_reversals_snakemake
        
        annotate_reversals_snakemake.main([
            '-i', str(input.curvature_file),
            '-pca', str(params.pca_model_path),
            '-i_s', str(params.initial_segment),
            '-f_s', str(params.final_segment),
            '-win', str(params.window),
            '-o_bh', str(output.behaviour_annotation),
            '-o_pc', str(output.principal_components),
            '--upper_threshold', str(params.upper_threshold),
            '--lower_threshold', str(params.upper_threshold),
        ])

