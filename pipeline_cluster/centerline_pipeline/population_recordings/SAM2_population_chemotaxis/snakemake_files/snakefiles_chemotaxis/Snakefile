rule chemotaxis_analysis:
    input:
        "{dataset}/{track_dir}/output/.meta.json",
        reversal_annotation      = "{dataset}/{track_dir}/output/reversal_annotation.csv",
        turn_annotation          = "{dataset}/{track_dir}/output/turn_annotation_by_roundness.csv",
        spline_K                 = "{dataset}/{track_dir}/output/skeleton_spline_K_new_smoothed.csv",
        skeleton_spline_X_coords = "{dataset}/{track_dir}/output/skeleton_spline_X_coords_new.csv",
        skeleton_spline_Y_coords = "{dataset}/{track_dir}/output/skeleton_spline_Y_coords_new.csv",
        conc_gradient_array      = config["conc_gradient_array"],
        distance_array           = config["distance_array"],
        DLC_filtered             = "{dataset}/{track_dir}/output/track" + config["network_string"] + "_filtered.h5",
    params:
        factor_px_to_mm       = config["factor_px_to_mm"],
        fps                   = config["fps"],
        diffusion_time_offset = config["diffusion_time_offset"],
        worm_pos              = "{dataset}/{track_dir}/track.txt",
        tif_path              = "{dataset}/{track_dir}/track.tif",
        dlc_nose_label        = config["nose"],
        dlc_tail_label        = config["tail"],
        bootstrap_iterations  = 10,
        bootstrap_seed        = 42,
        dC_lookback_frames    = 1,
    output:
        chemotaxis_visualisation = "{dataset}/{track_dir}/output/chemotaxis_analysis.pdf",
        chemotaxis_params        = "{dataset}/{track_dir}/output/chemotaxis_params.csv",
        chemotaxis_h5            = "{dataset}/{track_dir}/output/chemotaxis_analysis_complete.h5",
        done = touch("{dataset}/{track_dir}/output/chemotaxis_analysis.done")
    threads: create_scaled_threads_function("chemotaxis_analysis")
    resources:
        mem_mb    = create_scaled_memory_function("chemotaxis_analysis"),
        time      = create_scaled_time_function("chemotaxis_analysis"),
        partition = create_partition_function("chemotaxis_analysis"),
        gres      = create_gres_function("chemotaxis_analysis")
    run:
        from chemotaxis_analysis_high_res import initialize_load_files_high_res_universal_bootstrapping
        import tifffile as tiff
        from imutils import MicroscopeDataReader
        import dask.array as da
        import numpy as np
        import yaml
        from pathlib import Path

        def get_video_resolution(tif_path):
            reader_obj = MicroscopeDataReader(tif_path, as_raw_tiff=True, raw_tiff_num_slices=1)
            tif = da.squeeze(reader_obj.dask_array)
            for i, img in enumerate(tif):
                first_frame = np.array(img)
                video_resolution_y, video_resolution_x = first_frame.shape
                break
            return video_resolution_x, video_resolution_y

        def get_positions(track_id):
            config_path = Path(tif_path).resolve().parents[3] / "dataset_coordinates.yaml"
            with open(config_path, 'r') as f:
                all_coords = yaml.safe_load(f)

            if track_id not in all_coords:
                raise ValueError(f"Missing coordinates for '{track_id}' in dataset_coordinates.yaml. Use GUI to annotate.")

            entry = all_coords[track_id]
            print(f"Loaded coordinates for {track_id}:")
            print(f"  odor_pos: x={entry['odor_x']}, y={entry['odor_y']}")
            print(f"  top_left: x={entry['top_left_x']}, y={entry['top_left_y']}")

            return entry["odor_x"], entry["odor_y"], entry["top_left_x"], entry["top_left_y"]

        # Determine resolution
        tif_path = str(params.tif_path)
        video_resolution_x, video_resolution_y = get_video_resolution(tif_path)

        # Extract coordinates from YAML
        track_id = wildcards.dataset
        odor_x, odor_y, top_left_x, top_left_y = get_positions(track_id)
        odor_pos_str     = f"x={odor_x}, y={odor_y}"
        top_left_pos_str = f"x={top_left_x}, y={top_left_y}"

        # Call script
        initialize_load_files_high_res_universal_bootstrapping.main([
            '--reversal_annotation',      str(input.reversal_annotation),
            '--skeleton_spline',          str(input.spline_K),
            '--worm_pos',                 str(params.worm_pos),
            '--skeleton_spline_X_coords', str(input.skeleton_spline_X_coords),
            '--skeleton_spline_Y_coords', str(input.skeleton_spline_Y_coords),
            '--factor_px_to_mm',          str(params.factor_px_to_mm),
            '--video_resolution_x',       str(video_resolution_x),
            '--video_resolution_y',       str(video_resolution_y),
            '--fps',                      str(params.fps),
            '--conc_gradient_array',      str(input.conc_gradient_array),
            '--distance_array',           str(input.distance_array),
            '--turn_annotation',          str(input.turn_annotation),
            '--top_left_pos',             top_left_pos_str,
            '--odor_pos',                 odor_pos_str,
            '--diffusion_time_offset',    str(params.diffusion_time_offset),
            '--img_type',                 str('crop'),
            '--DLC_coords',               str(input.DLC_filtered),
            '--DLC_nose',                 str(params.dlc_nose_label),
            '--DLC_tail',                 str(params.dlc_tail_label),
            '--bootstrap_iterations',     str(params.bootstrap_iterations),
            '--bootstrap_seed',           str(params.bootstrap_seed),
            '--dC_lookback_frames',       str(params.dC_lookback_frames)
        ])
