        filtered_csv  = "{dataset}/{track_dir}/output/track" + config["network_string"] + "_filtered.csv"
    params:
        dlc_model_configfile_path = config["dlc_model_configfile_path"],
        shuffle                   = 2,
        window_length             = 9,
        p_bound                   = 0.001
    shell:
        """
        source /lisc/app/conda/miniforge3/bin/activate /lisc/app/conda/miniforge3/envs/deeplabcut-2.3.10
        python -c "import deeplabcut; deeplabcut.filterpredictions('{params.dlc_model_configfile_path}', ['{input.avi}'], shuffle={params.shuffle}, filtertype='arima', windowlength={params.window_length}, p_bound={params.p_bound}, save_as_csv=True)"
        """

rule create_centerline:
    input:
        input_binary_img = "{dataset}/{track_dir}/output/track_mask_corrected.btf",
        hdf5_file        = "{dataset}/{track_dir}/output/track" + config["network_string"] + "_filtered.h5"
    output:
        output_spline_K = "{dataset}/{track_dir}/output/skeleton_spline_K.csv",
        output_spline_X = "{dataset}/{track_dir}/output/skeleton_spline_X_coords.csv",
        output_spline_Y = "{dataset}/{track_dir}/output/skeleton_spline_Y_coords.csv"
    params:
        head_annotation  = config["nose"],
        tail_annotation  = config["tail"],
        number_of_spline = config["num_splines"],
        min_worm_length  = config["min_worm_lenght"]
    run:
        from centerline_behavior_annotation.centerline.dev import head_and_tail_low_res
        head_and_tail_low_res.main([
            '--input_binary_mask', str(input.input_binary_img),
            '--input_dlc_h5',      str(input.hdf5_file),
            '--head_annotation',   str(params.head_annotation),
            '--tail_annotation',   str(params.tail_annotation),
            '--number_of_spline',  str(params.number_of_spline),
            '--min_worm_length',   str(params.min_worm_length)
        ])

rule process_skeleton_curvature:
    input:
        skeleton_x = "{dataset}/{track_dir}/output/skeleton_spline_X_coords.csv",
        skeleton_y = "{dataset}/{track_dir}/output/skeleton_spline_Y_coords.csv"
    output:
        output_x                 = "{dataset}/{track_dir}/output/skeleton_spline_X_coords_new.csv",
        output_y                 = "{dataset}/{track_dir}/output/skeleton_spline_Y_coords_new.csv",
        output_curvature         = "{dataset}/{track_dir}/output/skeleton_spline_K_new.csv",
        output_smoothed_curvature= "{dataset}/{track_dir}/output/skeleton_spline_K_new_smoothed.csv"
    params:
        spacing             = config["relative_spacing"],
        num_sampled_points  = config["num_sampled_points"],
        smoothing           = config["smoothing"],
        time_sigma          = config["time_sigma"],
        spatial_sigma       = config["spatial_sigma"],
        max_columns         = config["max_columns"]
    run:
        from centerline_behavior_annotation.centerline.dev import centerline_equi_distance_2d_smoothing
        centerline_equi_distance_2d_smoothing.main([
            '--skeleton_x',                str(input.skeleton_x),
            '--skeleton_y',                str(input.skeleton_y),
            '--relative_spacing',          str(params.spacing),
            '--num_sampled_points',        str(params.num_sampled_points),
            '--smoothing',                 str(params.smoothing),
            '--time_sigma',                str(params.time_sigma),
            '--spatial_sigma',             str(params.spatial_sigma),
            '--max_columns',               str(params.max_columns),
            '--output_x',                  str(output.output_x),
            '--output_y',                  str(output.output_y),
            '--output_curvature',          str(output.output_curvature),
            '--output_smoothed_curvature', str(output.output_smoothed_curvature)
        ])

rule annotate_reversals:
    input:
        curvature_file = "{dataset}/{track_dir}/output/skeleton_spline_K_new_smoothed.csv"
    output:
        principal_components = "{dataset}/{track_dir}/output/principal_components.csv",
        behaviour_annotation = "{dataset}/{track_dir}/output/reversal_annotation.csv"
    params:
        pca_model_path   = config["pca_model_path"],
        initial_segment  = config["initial_segment"],
        final_segment    = config["final_segment"],
        window           = config["window"],
        upper_threshold  = config["upper_threshold"],
        lower_threshold  = config["lower_threshold"]
    run:
        from centerline_behavior_annotation.curvature.src import annotate_reversals_snakemake
        annotate_reversals_snakemake.main([
            '-i',    str(input.curvature_file),
            '-pca',  str(params.pca_model_path),
            '-i_s',  str(params.initial_segment),
            '-f_s',  str(params.final_segment),
            '-win',  str(params.window),
            '-o_bh', str(output.behaviour_annotation),
            '-o_pc', str(output.principal_components),
            '--upper_threshold', str(params.upper_threshold),
            '--lower_threshold', str(params.lower_threshold)
        ])

