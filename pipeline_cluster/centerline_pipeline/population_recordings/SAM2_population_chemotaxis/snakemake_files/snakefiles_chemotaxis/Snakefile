from snakemake.io import glob_wildcards, temp, touch

# Discover all datasets and their track directories
DATASETS = glob_wildcards("{dataset}/{track_dir}/track.tif")

rule all:
    input:
        expand(
            [
                "{dataset}/{track_dir}/output/chemotaxis_analysis.pdf",
                "{dataset}/{track_dir}/output/chemotaxis_params.csv",
                "{dataset}/{track_dir}/output/worm_movie.avi",
                # Add the new outputs to the all rule
                "{dataset}/{track_dir}/output/hilbert_regenerated_carrier.csv",
                "{dataset}/{track_dir}/output/hilbert_inst_freq.csv",
                "{dataset}/{track_dir}/output/hilbert_inst_phase.csv",
                "{dataset}/{track_dir}/output/hilbert_inst_amplitude.csv"
            ],
            zip,
            dataset=DATASETS.dataset,
            track_dir=DATASETS.track_dir
        )

rule tiff2avi:
    input:
        # the raw TIFF sits one level above output
        input_img = "{dataset}/{track_dir}/track.tif"
    output:
        avi = temp("{dataset}/{track_dir}/output/track.avi")
    params:
        function = "tiff2avi",
        fourcc   = config["fourcc"],
        fps      = config["fps"]
    run:
        # custom conversion via imutils parser
        from imutils.src import imutils_parser_main
        imutils_parser_main.main([
            params.function,
            '-i',     str(input.input_img),
            '-o',     str(output.avi),
            '-fourcc',str(params.fourcc),
            '-fps',   str(params.fps),
        ])

rule sam2_segment:
    input:
        avi     = "{dataset}/{track_dir}/output/track.avi",
        dlc_csv = "{dataset}/{track_dir}/output/track" + config["network_string"] + "_filtered.csv"
    output:
        mask = temp("{dataset}/{track_dir}/output/track_mask.btf")
    params:
        column_names      = ["neck"],
        model_path        = "/lisc/scratch/neurobiology/zimmer/schaar/code/github/segment-anything-2",
        downsample_factor = config["downsample_factor"],
        batch_size        = config["batch_size"]
    shell:
        """
        # Load CUDA toolkit module first
        module load cuda-toolkit/12.6.3

        # Activate the environment
        source /lisc/app/conda/miniforge3/bin/activate /lisc/scratch/neurobiology/zimmer/.conda/envs/SAM2_shared

        # Display the temporary directory being used
        echo "Using temporary directory: $TMPDIR"

        # Copy input files to the temporary directory with verification
        cp {input.avi} $TMPDIR/track.avi
        while [ ! -f $TMPDIR/track.avi ] || [ ! -s $TMPDIR/track.avi ]; do
            sleep 1
            echo "Waiting for avi file to be fully copied..."
        done

        cp {input.dlc_csv} $TMPDIR/track_dlc.csv
        while [ ! -f $TMPDIR/track_dlc.csv ] || [ ! -s $TMPDIR/track_dlc.csv ]; do
            sleep 1
            echo "Waiting for CSV file to be fully copied..."
        done

        # Add a small delay to ensure filesystem sync
        sleep 2

        # Run the script within the temporary directory
        python -c "from SAM2_snakemake_scripts.sam2_video_processing_from_jpeg_batch_pipeline import main; main(['-video_path','$TMPDIR/track.avi','-output_file_path','$TMPDIR/track_mask.btf','-DLC_csv_file_path','$TMPDIR/track_dlc.csv','-column_names','{params.column_names}','-SAM2_path','{params.model_path}','--batch_size','{params.batch_size}'])"

        # Verify output file exists and wait for it to be fully written
        while [ ! -f $TMPDIR/track_mask.btf ] || [ ! -s $TMPDIR/track_mask.btf ]; do
            sleep 1
            echo "Waiting for output file to be fully written..."
        done

        # Add a small delay before moving
        sleep 2

        # Move the output file back to the final output path
        mv $TMPDIR/track_mask.btf {output.mask}

        # Verify the move completed successfully
        while [ ! -f {output.mask} ] || [ ! -s {output.mask} ]; do
            sleep 1
            echo "Waiting for final file move to complete..."
        done

        # Clean up the temporary directory
        rm -rf $TMPDIR/*
        """

rule correct_SAM2_DLC_errors:
    input:
        mask_stack = "{dataset}/{track_dir}/output/track_mask.btf"
    output:
        processed_stack = temp("{dataset}/{track_dir}/output/track_mask_corrected.btf")
    params:
        script_path   = "/lisc/scratch/neurobiology/zimmer/schaar/code/github/segment-anything-2/pipeline_implementation/correct_SAM2_DLC_error_pipeline.py",
        min_worm_area = config["min_worm_area"],
        max_worm_area = config["max_worm_area"]
    shell:
        """
        python {params.script_path} {input.mask_stack} {output.processed_stack} {params.min_worm_area} {params.max_worm_area}
        """

rule dlc_analyze_videos:
    input:
        avi = "{dataset}/{track_dir}/output/track.avi"
    output:
        hdf5_file = temp("{dataset}/{track_dir}/output/track" + config["network_string"] + ".h5"),
        csv_file  = temp("{dataset}/{track_dir}/output/track" + config["network_string"] + ".csv")
    params:
        dlc_model_configfile_path = config["dlc_model_configfile_path"],
        shuffle                   = 2
    shell:
        """
        source /lisc/app/conda/miniforge3/bin/activate /lisc/app/conda/miniforge3/envs/deeplabcut-2.3.10
        module load cuda-toolkit/12.6.3
        python -c "import deeplabcut; deeplabcut.analyze_videos('{params.dlc_model_configfile_path}', '{input.avi}', videotype='avi', gputouse=${{CUDA_VISIBLE_DEVICES:-0}}, save_as_csv=True, shuffle={params.shuffle})"
        """

