from snakemake.io import glob_wildcards, temp, touch

# ---- dynamic per-rule resources from cluster_config.yaml ----
import json, math, re, yaml
from functools import lru_cache

MAX_CROP_SEC = 1800  # 30 minutes baseline

# read cluster_config once
with open("cluster_config.yaml") as _f:
    _CLUSTER_CONFIG = yaml.safe_load(_f)

def get_cluster_config_value(rule_name, config_key, default=None):
    """Get a configuration value for a specific rule, with fallback to __default__"""
    if rule_name in _CLUSTER_CONFIG and config_key in _CLUSTER_CONFIG[rule_name]:
        value = _CLUSTER_CONFIG[rule_name][config_key]
        return value if value is not None else default
    if "__default__" in _CLUSTER_CONFIG and config_key in _CLUSTER_CONFIG["__default__"]:
        value = _CLUSTER_CONFIG["__default__"][config_key]
        return value if value is not None else default
    return default

def parse_memory_to_mb(memory_string):
    """Convert memory string (e.g., '64G', '64000M') to megabytes"""
    if isinstance(memory_string, (int, float)): 
        return int(memory_string)
    s = str(memory_string).strip().upper()
    m = re.match(r"^(\d+(?:\.\d+)?)([KMG]B?|)$", s)
    if not m:  # last resort: assume MB
        return int(float(re.sub(r"\D", "", s) or 0))
    val, unit = float(m.group(1)), m.group(2)
    if unit in ("G", "GB"): 
        return int(val * 1024)
    if unit in ("M", "MB", ""): 
        return int(val)
    if unit in ("K", "KB"): 
        return int(val / 1024)
    return int(val)

def parse_time_to_seconds(time_string):
    """Convert SLURM time format (D-HH:MM:SS, HH:MM:SS, MM:SS) to seconds"""
    if isinstance(time_string, (int, float)): 
        return int(time_string)
    s = str(time_string).strip()
    days = 0
    if "-" in s:
        days_str, s = s.split("-", 1)
        days = int(days_str)
    parts = [int(p) for p in s.split(":")]
    if len(parts) == 3:
        h, m, sec = parts
    elif len(parts) == 2:
        h, m, sec = 0, parts[0], parts[1]
    else:
        h, m, sec = 0, 0, parts[0]
    return days*86400 + h*3600 + m*60 + sec

def format_seconds_to_slurm_time(seconds):
    """Convert seconds to SLURM time format (D-HH:MM:SS)"""
    seconds = int(seconds)
    d, r = divmod(seconds, 86400)
    h, r = divmod(r, 3600)
    m, s = divmod(r, 60)
    return f"{d}-{h:02d}:{m:02d}:{s:02d}" if d else f"{h:02d}:{m:02d}:{s:02d}"

@lru_cache(None)
def get_video_metadata(dataset, track_dir):
    """
    Read video duration and frame count from .meta.json file.
    Returns (duration_seconds, frame_count) or defaults if file doesn't exist.
    """
    path = f"{dataset}/{track_dir}/output/.meta.json"
    try:
        with open(path) as f:
            streams = json.load(f).get("streams", [])
        s = streams[0] if streams else {}
        return float(s.get("duration") or 0.0), int(s.get("nb_frames") or 0)
    except (FileNotFoundError, json.JSONDecodeError):
        # Return baseline 30-min duration for initial resource allocation
        return MAX_CROP_SEC, 0

def get_video_duration_seconds(wildcards):
    """Get video duration in seconds for a specific dataset/track"""
    duration_sec, _ = get_video_metadata(wildcards.dataset, wildcards.track_dir)
    return max(1.0, duration_sec)  # avoid zero

# ----- Resource Scaling Functions (based on video duration) -----
def create_scaled_threads_function(rule_name):
    """Returns a function that scales thread count based on video duration"""
    def calculate_threads(wildcards):
        base = int(get_cluster_config_value(rule_name, "cpus_per_task", 1))
        scale = get_video_duration_seconds(wildcards) / MAX_CROP_SEC
        return max(1, min(base, math.ceil(base * scale)))
    return calculate_threads

def create_scaled_memory_function(rule_name):
    """Returns a function that scales memory (MB) based on video duration"""
    def calculate_memory(wildcards):
        base_mb = parse_memory_to_mb(get_cluster_config_value(rule_name, "mem", "64G"))
        scale = get_video_duration_seconds(wildcards) / MAX_CROP_SEC
        return max(1000, min(base_mb, int(base_mb * scale)))
    return calculate_memory

def create_scaled_time_function(rule_name):
    """Returns a function that scales walltime based on video duration"""
    def calculate_time(wildcards):
        base_time = get_cluster_config_value(rule_name, "time", "0-08:00:00")
        base_sec = parse_time_to_seconds(base_time)
        scale = get_video_duration_seconds(wildcards) / MAX_CROP_SEC
        scaled_sec = max(600, min(base_sec, int(base_sec * scale)))
        return format_seconds_to_slurm_time(scaled_sec)
    return calculate_time

def create_partition_function(rule_name):
    """Returns partition value from cluster_config.yaml (no scaling)"""
    def get_partition(wildcards):
        return get_cluster_config_value(rule_name, "partition", "basic")
    return get_partition

def create_gres_function(rule_name):
    """Returns GRES value from cluster_config.yaml (no scaling)"""
    def get_gres(wildcards):
        return get_cluster_config_value(rule_name, "gres", "")
    return get_gres

def create_constraint_function(rule_name):
    """Returns constraint value from cluster_config.yaml (no scaling)"""
    def get_constraint(wildcards):
        return get_cluster_config_value(rule_name, "constraint", "")
    return get_constraint

# ----- Static Resource Functions (no scaling, used for tiff2avi and sam2_segment) -----
def create_static_threads_function(rule_name):
    """Returns a function that returns fixed thread count from cluster_config"""
    def get_threads(wildcards):
        return int(get_cluster_config_value(rule_name, "cpus_per_task", 1))
    return get_threads

def create_static_memory_function(rule_name):
    """Returns a function that returns fixed memory (MB) from cluster_config"""
    def get_memory(wildcards):
        return parse_memory_to_mb(get_cluster_config_value(rule_name, "mem", "64G"))
    return get_memory

def create_static_time_function(rule_name):
    """Returns a function that returns fixed time from cluster_config"""
    def get_time(wildcards):
        return get_cluster_config_value(rule_name, "time", "0-08:00:00")
    return get_time

