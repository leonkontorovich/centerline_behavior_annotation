        time=create_scaled_time_function("calc_turns_by_roundness"),
        partition=create_partition_function("calc_turns_by_roundness"),
        gres=create_gres_function("calc_turns_by_roundness")
    params:
        min_round_threshold = config["min_round_threshold"],
        max_round_threshold = config["max_round_threshold"],
        smoothing_window    = lambda wildcards: int(round(swc_fps(wildcards.dataset))),
        min_worm_area       = lambda wildcards: swc_min_worm_area(wildcards.dataset),
        max_worm_area       = lambda wildcards: swc_max_worm_area(wildcards.dataset)
