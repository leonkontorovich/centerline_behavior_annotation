            '--lower_threshold', str(params.lower_threshold)
        ])

rule calc_turns_by_roundness:
    input:
        "{dataset}/{track_dir}/output/.meta.json",
        mask_stack = "{dataset}/{track_dir}/output/track_mask_corrected.btf"
    output:
        turn_annotation = "{dataset}/{track_dir}/output/turn_annotation_by_roundness.csv"
