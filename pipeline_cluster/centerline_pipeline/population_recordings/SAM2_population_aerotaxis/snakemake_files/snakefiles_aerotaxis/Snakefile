            '-max_worm_area', str(params.max_worm_area),
            '-window',        str(params.smoothing_window),
            '-output_file',   str(output.turn_annotation)
        ])

# Added rule: Hilbert transform on kymogram
rule hilbert_transform_on_kymogram:
    input:
        "{dataset}/{track_dir}/output/.meta.json",
        spline_K = "{dataset}/{track_dir}/output/skeleton_spline_K_new_smoothed.csv"
    output:
        # Changed to keep the outputs as final results (not temp)
        hilbert_regenerated_carrier = "{dataset}/{track_dir}/output/hilbert_regenerated_carrier.csv",
        hilbert_inst_freq = "{dataset}/{track_dir}/output/hilbert_inst_freq.csv",
        hilbert_inst_phase = "{dataset}/{track_dir}/output/hilbert_inst_phase.csv",
        hilbert_inst_amplitude = "{dataset}/{track_dir}/output/hilbert_inst_amplitude.csv"
    threads: create_scaled_threads_function("hilbert_transform_on_kymogram")
    resources:
        mem_mb=create_scaled_memory_function("hilbert_transform_on_kymogram"),
        time=create_scaled_time_function("hilbert_transform_on_kymogram"),
        partition=create_partition_function("hilbert_transform_on_kymogram"),
        gres=create_gres_function("hilbert_transform_on_kymogram")
    params:
        output_path = "{dataset}/{track_dir}/output/", # Ulises' functions expect the final slash
        fs = lambda wildcards: swc_fps(wildcards.dataset),
        window = lambda wildcards: int(round(swc_fps(wildcards.dataset)))
    run:
        from centerline_behavior_annotation.behavior_analysis.src import hilbert_transform

        hilbert_transform.main([
            '-i', str(params.output_path),
            '-kp', str(input.spline_K),
            '-fs', str(params.fs),
            '-w', str(params.window),
        ])
        
rule aerotaxis_temporal_analysis:
    """
    Temporal (non-spatial) behavioural analysis for global gas-shift assays.

    Replaces the spatial chemotaxis rule: no odor position, no concentration/
    distance arrays, no chemotaxis index. Behaviour is aligned to the global O2
    protocol defined in config["aerotaxis"] and written as a tidy per-frame CSV.
    """
    input:
        "{dataset}/{track_dir}/output/.meta.json",
        reversal_annotation      = "{dataset}/{track_dir}/output/reversal_annotation.csv",
        turn_annotation          = "{dataset}/{track_dir}/output/turn_annotation_by_roundness.csv",
        skeleton_spline_X_coords = "{dataset}/{track_dir}/output/skeleton_spline_X_coords_new.csv",
        skeleton_spline_Y_coords = "{dataset}/{track_dir}/output/skeleton_spline_Y_coords_new.csv",
        # Body-bend metrics from the existing Hilbert rule (locomotor arousal)
        hilbert_inst_freq        = "{dataset}/{track_dir}/output/hilbert_inst_freq.csv",
        hilbert_inst_amplitude   = "{dataset}/{track_dir}/output/hilbert_inst_amplitude.csv",
    params:
        factor_px_to_mm     = lambda wildcards: swc_factor_px_to_mm(wildcards.dataset),
        fps                 = lambda wildcards: swc_fps(wildcards.dataset),
        worm_pos            = "{dataset}/{track_dir}/track.txt",
        crop_id             = "{track_dir}",
        # Global gas protocol (see config["aerotaxis"]) -- edit per assay, no code change
        t0_offset_s         = config["aerotaxis"]["t0_offset_s"],
        baseline_duration_s = config["aerotaxis"]["baseline_duration_s"],
        baseline_state      = config["aerotaxis"]["baseline_state"],
        cycle_json          = json.dumps(config["aerotaxis"]["cycle"]),
        n_cycles            = config["aerotaxis"]["n_cycles"] if config["aerotaxis"]["n_cycles"] is not None else "none",
        script              = "extract_temporal_features.py",  # copied alongside the Snakefile
    output:
        temporal_features = "{dataset}/{track_dir}/output/temporal_features.csv",
        done = touch("{dataset}/{track_dir}/output/aerotaxis_temporal_analysis.done")
    threads: create_static_threads_function("aerotaxis_temporal_analysis")
    resources:
        mem_mb    = create_static_memory_function("aerotaxis_temporal_analysis"),
        time      = create_static_time_function("aerotaxis_temporal_analysis"),
        partition = create_partition_function("aerotaxis_temporal_analysis"),
        gres      = create_gres_function("aerotaxis_temporal_analysis")
    shell:
        '''
        python "{workflow.basedir}/{params.script}" \
            --crop_id "{params.crop_id}" \
            --reversal_annotation "{input.reversal_annotation}" \
            --turn_annotation "{input.turn_annotation}" \
            --skeleton_x "{input.skeleton_spline_X_coords}" \
            --skeleton_y "{input.skeleton_spline_Y_coords}" \
            --worm_pos "{params.worm_pos}" \
            --bend_freq "{input.hilbert_inst_freq}" \
            --bend_amplitude "{input.hilbert_inst_amplitude}" \
            --fps "{params.fps}" \
            --factor_px_to_mm "{params.factor_px_to_mm}" \
            --t0_offset_s "{params.t0_offset_s}" \
            --baseline_duration_s "{params.baseline_duration_s}" \
            --baseline_state "{params.baseline_state}" \
            --cycle_json '{params.cycle_json}' \
            --n_cycles "{params.n_cycles}" \
            --out_csv "{output.temporal_features}"
        '''
