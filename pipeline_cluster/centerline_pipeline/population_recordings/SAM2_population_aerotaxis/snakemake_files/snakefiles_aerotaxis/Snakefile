rule dlc_filter_predictions_arima:
    input:
        "{dataset}/{track_dir}/output/.meta.json",
        hdf5_file = "{dataset}/{track_dir}/output/track" + config["network_string"] + ".h5",
        csv_file  = "{dataset}/{track_dir}/output/track" + config["network_string"] + ".csv",
        avi       = "{dataset}/{track_dir}/output/track.avi"
    output:
        filtered_hdf5 = "{dataset}/{track_dir}/output/track" + config["network_string"] + "_filtered.h5",
        filtered_csv  = "{dataset}/{track_dir}/output/track" + config["network_string"] + "_filtered.csv"
    threads: create_scaled_threads_function("dlc_filter_predictions_arima")
    resources:
        mem_mb=create_scaled_memory_function("dlc_filter_predictions_arima"),
        time=create_scaled_time_function("dlc_filter_predictions_arima"),
        partition=create_partition_function("dlc_filter_predictions_arima"),
        gres=create_gres_function("dlc_filter_predictions_arima")
    params:
        dlc_model_configfile_path = config["dlc_model_configfile_path"],
        dlc_conda_env_path        = config["dlc_conda_env_path"],
        shuffle                   = 2,
        window_length             = 9,
        p_bound                   = 0.001
    shell:
        """
        source /lisc/opt/sw/software/Conda/Miniforge3/bin/activate {params.dlc_conda_env_path}
        python -c "import deeplabcut; deeplabcut.filterpredictions('{params.dlc_model_configfile_path}', ['{input.avi}'], shuffle={params.shuffle}, filtertype='arima', windowlength={params.window_length}, p_bound={params.p_bound}, save_as_csv=True)"
        """

rule create_centerline:
    input:
        "{dataset}/{track_dir}/output/.meta.json",
        input_binary_img = "{dataset}/{track_dir}/output/track_mask_corrected.btf",
        hdf5_file        = "{dataset}/{track_dir}/output/track" + config["network_string"] + "_filtered.h5"
    output:
        output_spline_K = "{dataset}/{track_dir}/output/skeleton_spline_K.csv",
        output_spline_X = "{dataset}/{track_dir}/output/skeleton_spline_X_coords.csv",
        output_spline_Y = "{dataset}/{track_dir}/output/skeleton_spline_Y_coords.csv"
    threads: create_scaled_threads_function("create_centerline")
    resources:
        mem_mb=create_scaled_memory_function("create_centerline"),
        time=create_scaled_time_function("create_centerline"),
        partition=create_partition_function("create_centerline"),
        gres=create_gres_function("create_centerline")
    params:
        head_annotation  = config["nose"],
        tail_annotation  = config["tail"],
        number_of_spline = config["num_splines"],
        # Derived per recording from the mm floor and SWC's px->mm calibration,
        # NOT a fixed pixel constant -- see swc_min_worm_length().
        min_worm_length  = lambda wildcards: swc_min_worm_length(wildcards.dataset)
    run:
        from centerline_behavior_annotation.centerline.dev import head_and_tail_low_res
        head_and_tail_low_res.main([
            '--input_binary_mask', str(input.input_binary_img),
            '--input_dlc_h5',      str(input.hdf5_file),
            '--head_annotation',   str(params.head_annotation),
            '--tail_annotation',   str(params.tail_annotation),
            '--number_of_spline',  str(params.number_of_spline),
            '--min_worm_length',   str(params.min_worm_length)
        ])

