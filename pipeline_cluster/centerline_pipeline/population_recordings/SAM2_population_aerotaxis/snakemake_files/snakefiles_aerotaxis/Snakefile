# Discover all datasets and their track directories
DATASETS = glob_wildcards("{dataset}/{track_dir}/track.tif")

rule all:
    input:
        expand(
            [
                # Aerotaxis temporal analysis (replaces spatial chemotaxis outputs)
                "{dataset}/{track_dir}/output/temporal_features.csv",
                "{dataset}/{track_dir}/output/aerotaxis_temporal_analysis.done",
                # Hilbert body-bend outputs (gradient-independent, kept)
                "{dataset}/{track_dir}/output/hilbert_regenerated_carrier.csv",
                "{dataset}/{track_dir}/output/hilbert_inst_freq.csv",
                "{dataset}/{track_dir}/output/hilbert_inst_phase.csv",
                "{dataset}/{track_dir}/output/hilbert_inst_amplitude.csv"
            ],
            zip,
            dataset=DATASETS.dataset,
            track_dir=DATASETS.track_dir
        )

rule tiff2avi:
    input:
        "{dataset}/{track_dir}/output/.meta.json",
        input_img = "{dataset}/{track_dir}/track.tif"
    output:
        avi = temp("{dataset}/{track_dir}/output/track.avi")
    threads: create_scaled_threads_function("tiff2avi")
    resources:
        mem_mb=create_scaled_memory_function("tiff2avi"),
        time=create_scaled_time_function("tiff2avi"),
        partition=create_partition_function("tiff2avi"),
        gres=create_gres_function("tiff2avi")
    params:
        function = "tiff2avi",
        fourcc   = config["fourcc"],
        fps      = lambda wildcards: swc_fps(wildcards.dataset)
    run:
        from imutils.src import imutils_parser_main
        imutils_parser_main.main([
            params.function,
            '-i',     str(input.input_img),
            '-o',     str(output.avi),
            '-fourcc',str(params.fourcc),
            '-fps',   str(params.fps),
        ])

rule sam2_segment:
    input:
        "{dataset}/{track_dir}/output/.meta.json",
        input_img = "{dataset}/{track_dir}/track.tif", 
        dlc_csv = "{dataset}/{track_dir}/output/track" + config["network_string"] + "_filtered.csv"
    output:
        mask = temp("{dataset}/{track_dir}/output/track_mask.btf")
    threads: create_static_threads_function("sam2_segment")
    resources:
        mem_mb=create_static_memory_function("sam2_segment"),
        time=create_static_time_function("sam2_segment"),
        partition=create_partition_function("sam2_segment"),
        gres=create_gres_function("sam2_segment")
    params:
        column_names      = ["neck"],
        model_path        = "/lisc/data/scratch/neurobiology/zimmer/schaar/code/github/segment-anything-2",
        sam2_conda_env_name = "/lisc/data/scratch/neurobiology/zimmer/.conda/envs/SAM2_shared",
        batch_size        = config["batch_size"]
    shell:
        '''
        # I started getting an error with the xml_catalog_files_libxml2 variable, so check if it is set
        if [ -z "${{xml_catalog_files_libxml2:-}}" ]; then
            export xml_catalog_files_libxml2=""
        fi

        module load CUDA/12.9.1

        # Activate the environment and the correct cuda
        source /lisc/opt/sw/software/Conda/Miniforge3/bin/activate {params.sam2_conda_env_name}

        # Run the script directly without temp directory overhead
        python -c "from SAM2_snakemake_scripts.sam2_video_processing_miscroscope_data_loader import main; main(['-tiff_path', '{input.input_img}', '-output_file_path', '{output.mask}', '-DLC_csv_file_path', '{input.dlc_csv}', '-column_names', '{params.column_names}', '-SAM2_path', '{params.model_path}', '--batch_size', '{params.batch_size}', '--device', '${{CUDA_VISIBLE_DEVICES:-0}}'])"
        '''

