        output_curvature         = "{dataset}/{track_dir}/output/skeleton_spline_K_new.csv",
        output_smoothed_curvature= "{dataset}/{track_dir}/output/skeleton_spline_K_new_smoothed.csv"
    threads: create_scaled_threads_function("process_skeleton_curvature")
