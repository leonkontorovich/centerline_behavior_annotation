        mem_mb=create_scaled_memory_function("process_skeleton_curvature"),
        time=create_scaled_time_function("process_skeleton_curvature"),
        partition=create_partition_function("process_skeleton_curvature"),
        gres=create_gres_function("process_skeleton_curvature")
    params:
        spacing             = config["relative_spacing"],
        num_sampled_points  = config["num_sampled_points"],
        smoothing           = config["smoothing"],
        time_sigma          = config["time_sigma"],
        spatial_sigma       = config["spatial_sigma"],
        max_columns         = config["max_columns"]
